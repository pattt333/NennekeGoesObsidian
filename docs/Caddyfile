# Caddyfile for Docsify deployment
#
# This configuration serves the TTRPG Rulebook vault using Caddy web server.
# Place this file in your Caddy configuration directory and adjust the domain.
#
# Usage:
#   1. Copy this file to /etc/caddy/Caddyfile or your Caddy configuration location
#   2. Replace 'rules.yourdomain.com' with your actual subdomain
#   3. Adjust the root path to point to your vault directory
#   4. Reload Caddy: sudo systemctl reload caddy
#
# For local testing without HTTPS:
#   caddy file-server --listen :8080 --root ./vault

rules.yourdomain.com {
    root * /path/to/NennekeObsidian/vault
    file_server
    
    # Enable gzip compression
    encode gzip
    
    # Try index.html for SPA routing
    try_files {path} {path}/ /index.html
    
    # Cache static assets
    @static {
        path *.css *.js *.ico *.png *.jpg *.jpeg *.gif *.svg *.woff *.woff2
    }
    header @static Cache-Control "public, max-age=31536000"
}
