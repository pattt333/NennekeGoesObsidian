[Unit]
Description=Nenneke Discord Bot
Documentation=https://github.com/pattt333/NennekeObsidian
After=network.target

[Service]
Type=simple
User=nenneke
WorkingDirectory=/opt/NennekeObsidian/discord-bot
ExecStart=/usr/bin/node bot.js
Restart=on-failure
RestartSec=10

# Environment file containing DISCORD_TOKEN
EnvironmentFile=/opt/NennekeObsidian/discord-bot/.env

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nenneke-discord-bot

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/NennekeObsidian/vault /opt/NennekeObsidian/discord-bot

[Install]
WantedBy=multi-user.target
