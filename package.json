{
  "name": "nenneke-obsidian-rulebook",
  "version": "1.0.0",
  "description": "TTRPG Rulebook Documentation",
  "scripts": {
    "serve": "docsify serve vault",
    "pdf": "cd vault && docsify-pdf-converter",
    "pdf:custom": "cd vault && docsify-pdf-converter --cover _coverpage.md",
    "validate:links": "node scripts/vault-health-check.js",
    "validate:orphans": "node scripts/find-orphaned-files.js",
    "nenneke:inventory": "node scripts/run_nenneke_pipeline.js inventory",
    "nenneke:convert": "node scripts/run_nenneke_pipeline.js convert",
    "nenneke:apply": "node scripts/run_nenneke_pipeline.js apply",
    "nenneke:validate": "node scripts/run_nenneke_pipeline.js validate",
    "nenneke:test": "node scripts/run_nenneke_pipeline.js test",
    "nenneke:pdf": "node scripts/run_nenneke_pipeline.js publish"
  },
  "keywords": ["docsify", "documentation", "ttrpg"],
  "author": "",
  "license": "MIT"
}
